{
  "name": "FlipDown",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build-aab": "npx react-native build-android --mode=release",
    "build-debug": "cd android && ./gradlew assembleDebug",
    "build-apk": "cd android && ./gradlew assembleRelease",
    "clean-watchman": "watchman watch-del-all",
    "reinstall-node-modules": "rm -rf node_modules && yarn",
    "reinstall-pods": "rm -rf ios/build ios/Pods ios/Podfile.lock && yarn install-pods",
    "clean-ios": "watchman watch-del-all && rm -rf node_modules && rm -rf ios/build && rm -rf ios/Pods && rm -rf ios/Podfile.lock && rm -rf ~/Library/Developer/Xcode/DerivedData",
    "pod-install": "cd ios && pod install",
    "run-ios-16-pro": "npx react-native run-ios --simulator=\"iPhone 16 Pro\"",
    "run-ios-se": "npx react-native run-ios --simulator=\"iPhone SE\"",
    "run-ios-16-plus": "npx react-native run-ios --simulator=\"iPhone 16 Plus\"",
    "run-ios-17": "npx react-native run-ios --simulator=\"iPhone 17\"",
    "run-ios-17-pro": "npx react-native run-ios --simulator=\"iPhone 17 Pro\"",
    "run-ios-17-pro-max": "npx react-native run-ios --simulator=\"iPhone 17 Pro Max\"",
    "setup": "yarn",
    "start": "npx react-native start --reset-cache",
    "run-android": "npx react-native run-android",
    "run-ios": "npx react-native run-ios",
    "clean-android": "cd android && ./gradlew --no-daemon && ./gradlew clean && cd ..",
    "clean-android-cache": "rm -rf android/.gradle && rm -rf android/app/build && rm -rf android/build",
    "test": "jest",
    "upgrade-all-deps": "npx npm-check-updates --concurrency 999999999 --deep -l silly --timeout 999999999 -u && yarn run setup",
    "upgrade-dev-deps": "npx npm-check-updates --concurrency 999999999 --deep --dep dev -l silly --timeout 999999999 -u && yarn run setup"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^4.6.0",
    "@react-native-camera-roll/camera-roll": "7.10.2",
    "@react-native-clipboard/clipboard": "^1.14.1",
    "@react-native-community/cli": "^19.1.1",
    "@react-native-community/cli-platform-android": "19.1.1",
    "@react-native-community/cli-platform-ios": "19.1.1",
    "@react-native-community/netinfo": "^11.3.2",
    "@react-native-firebase/analytics": "^20.1.0",
    "@react-native-firebase/app": "^20.1.0",
    "@react-native-firebase/messaging": "^20.1.0",
    "@react-native/new-app-screen": "0.80.2",
    "@react-navigation/bottom-tabs": "^6.3.1",
    "@react-navigation/native": "^6.0.10",
    "@react-navigation/native-stack": "^6.6.2",
    "@reduxjs/toolkit": "^2.1.0",
    "@types/react-native-share-menu": "^5.0.5",
    "axios": "^1.6.7",
    "babel-plugin-module-resolver": "^5.0.0",
    "fbjs": "^3.0.5",
    "husky": "^9.0.11",
    "lottie-react-native": "7.3.4",
    "pod-install": "^0.2.0",
    "react": "19.1.0",
    "react-native": "0.80.2",
    "react-native-blob-util": "^0.19.9",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.15.0",
    "react-native-google-mobile-ads": "^14.1.0",
    "react-native-localization": "^2.3.2",
    "react-native-permissions": "^4.1.5",
    "react-native-reanimated": "4.1.3",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.18.0",
    "react-native-share": "12.2.0",
    "react-native-share-menu": "^6.0.0",
    "react-native-sound": "^0.13.0",
    "react-native-splash-screen": "^3.3.0",
    "react-native-star-rating-widget": "^1.9.1",
    "react-native-svg": "15.14.0",
    "react-native-video": "6.19.2",
    "react-native-worklets": "0.5.2",
    "react-native-yandex-mobile-ads": "^0.9.1",
    "react-redux": "^9.1.0",
    "redux-thunk": "^3.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/babel-preset": "0.80.2",
    "@react-native/eslint-config": "0.80.2",
    "@react-native/metro-config": "0.80.2",
    "@react-native/typescript-config": "0.80.2",
    "@types/node": "^20.14.8",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^9.5.0",
    "jest": "^29.6.3",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^2.8.8",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=18"
  }
}
